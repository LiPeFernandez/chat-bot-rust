# Copie este arquivo para .env e ajuste os valores.
# O processo também aceita as mesmas variáveis exportadas no shell.

# --- Cérebro LLM (API compatível com OpenAI) ---
# Ollama local não valida a chave; qualquer valor não vazio serve.
LLM_API_KEY=ollama
# Ollama: http://localhost:11434/v1
# vLLM:   http://localhost:8000/v1
# xAI:    https://api.x.ai/v1
# DeepInfra: https://api.deepinfra.com/v1/openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Sandbox Docker ---
# python:3.11-slim traz python e /bin/sh (não traz bash).
# Para bash de verdade, use uma imagem que o contenha e SANDBOX_SHELL=/bin/bash.
SANDBOX_IMAGE=python:3.11-slim
# none = sem rede (padrão, reduz efeito de prompt injection).
# bridge = saída para a internet pela rede Docker padrão.
SANDBOX_NETWORK=none
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_SECS=30
SANDBOX_USER=1000:1000
SANDBOX_PIDS_LIMIT=128
SANDBOX_SHELL=/bin/sh
SANDBOX_PYTHON=python

# --- Agent loop ---
AGENT_MAX_ITERATIONS=10

# --- Interface web ---
WEB_PORT=8787

# --- Logs ---
# trace, debug, info, warn, error
RUST_LOG=info
